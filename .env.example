# Copie este arquivo para .env (cp .env.example .env) e ajuste os valores.
# O app sobe sem .env — os padrões abaixo são usados quando a variável não
# existe. Configure apenas o que você precisa.

# Banco de dados (padrão: SQLite local em ./data)
DATABASE_URL=sqlite:///./data/controle_financeiro.db

# SECRET_KEY: opcional e atualmente não utilizada (as sessões usam tokens
# aleatórios em memória). Mantida para uso futuro.
SECRET_KEY=

# Google OAuth (login com Google): sem as credenciais, o botão de login
# com Google fica oculto mesmo com GOOGLE_OAUTH_ENABLED=1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Habilita/desabilita o login com Google OAuth: 1 (padrão) ou 0.
# Com GOOGLE_OAUTH_ENABLED=0 o botão some do login e os endpoints OAuth
# respondem "desativado", mesmo com credenciais configuradas.
GOOGLE_OAUTH_ENABLED=0

# Cache das cotações do yfinance em segundos (padrão 3600 = 1h)
QUOTE_CACHE_TTL=3600

# Limite de criação de contas: 0 = sem limite; qualquer valor positivo
# limita o número máximo de usuários.
ACCOUNT_QUOTA=0

# Atributo Secure do cookie de sessão:
#   auto (padrão): cookie Secure apenas sobre HTTPS
#   1: força Secure (app atrás de proxy TLS sem --proxy-headers)
#   0: nunca Secure (apenas desenvolvimento local)
COOKIE_SECURE=auto

# Usuários com papel de administrador (gerenciam tipos/categorias
# compartilhados), separados por vírgula. Sem esta variável, ninguém
# gerencia tipos — os padrão já existem via seed.
# ADMIN_USERNAMES=usuario_admin

# Origens adicionais permitidas (CORS + redirect_uri do OAuth Google),
# separadas por vírgula. Os domínios padrão (betoschneider.com,
# financeiro.betoschneider.com, localhost:8520) já estão incluídos.
# ALLOWED_ORIGINS=https://fin.btoplay.com
